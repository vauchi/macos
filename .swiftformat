# Exclude auto-generated UniFFI bindings from formatting
--exclude Vauchi/Generated/vauchi_platform.swift
--exclude Vauchi/Libs/VauchiPlatformLocal/Sources/VauchiPlatform/vauchi_platform.swift
--exclude Vauchi/Libs/VauchiPlatformLocal/.build
--exclude DerivedData
--exclude build

# CI and every developer run the same swiftformat; an older one fails
# here instead of passing code CI then rejects (#489).
--minversion 0.63.1
